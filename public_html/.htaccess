# =====================================================================
# JSD Construction - root .htaccess (Apache / cPanel)
# HTTPS, security headers, deny internals, no PHP execution in /uploads.
# =====================================================================

Options -Indexes -MultiViews

# ---------- Force HTTPS ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block any attempt to execute scripts that were uploaded into /uploads.
  RewriteRule ^uploads/.*\.(php|phtml|php[0-9]?|phar|pht|cgi|pl|py|asp|aspx|sh)$ - [F,NC]
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com; frame-src https://www.google.com; connect-src 'self' https://www.google.com; form-action 'self'"
  # Do not leak the CSRF/session header to caches.
  Header set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# ---------- Deny access to sensitive files ----------
<FilesMatch "(^\.|composer\.(json|lock)|\.(sample|sql|md|log|ini|sh|bak)$)">
  Require all denied
</FilesMatch>

# Deny access to PHP internals that should only be included, never hit directly.
<FilesMatch "^(bootstrap|csrf|db|mailer|media-lib|layout|auth)\.php$">
  Require all denied
</FilesMatch>

# ---------- Static asset caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---------- Pretty error fallback ----------
DirectoryIndex index.php index.html
